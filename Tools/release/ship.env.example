# The release lane's settings for one Mac. Copy this file to
# ~/.config/qotafolio/ship.env and fill in your own values; ship.sh sources it
# and every step but health and triage refuses to run without it.
#
# None of this is secret on its own — it names who signs and where the release
# goes — but it is yours, not the source's, so it does not belong in the tree.

# The App Store Connect API key that notarizes. Create it at
# App Store Connect → Users and Access → Integrations, download the .p8 once,
# and put it somewhere only you can read.
KEY_PATH="$HOME/.config/qotafolio/AuthKey_XXXXXXXXXX.p8"
KEY_ID="XXXXXXXXXX"
ISSUER="00000000-0000-0000-0000-000000000000"

# The Apple Developer team the app is signed by: the same string as
# DEVELOPMENT_TEAM in project.yml.
TEAM="XXXXXXXXXX"

# The login-Keychain account holding the private EdDSA key that signs the update
# feed. Sparkle's generate_keys writes it; the matching public key is
# SUPublicEDKey in Sources/Info.plist.
SPARKLE_ACCOUNT="net.c2coast.QotaFolio"

# owner/name of the GitHub repository the release page and the update feed
# point at.
REPO_SLUG="c2coast/QotaFolio"
