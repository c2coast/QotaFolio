      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy web address"
          }
        }
      }
    },
    "auth.chatgpt.copyCode": {
      "comment": "Copy the exact ChatGPT device code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy code"
          }
        }
      }
    },
    "auth.chatgpt.expired": {
      "comment": "The ChatGPT device code is no longer valid.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code expired"
          }
        }
      }
    },
    "auth.chatgpt.expired.body": {
      "comment": "Instructions after a ChatGPT device code expires.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a new code to continue. The ChatGPT authorization page remains the correct page."
          }
        }
      }
    },
    "auth.chatgpt.expires": {
      "comment": "Visible countdown for the active ChatGPT device code. Never announce every tick.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code expires in %1$lldm %2$llds"
          }
        }
      }
    },
    "auth.chatgpt.getNewCode": {
      "comment": "Request a fresh ChatGPT device code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a new code"
          }
        }
      }
    },
    "auth.chatgpt.instructions": {
      "comment": "Instructions for the active ChatGPT device-code flow.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the page below and enter this code:"
          }
        }
      }
    },
    "auth.chatgpt.openPage": {
      "comment": "Open the ChatGPT device authorization page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open ChatGPT authorization page"
          }
        }
      }
    },
    "auth.disclosure": {
      "comment": "Read-only OAuth and non-affiliation disclosure shown before provider handoff.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QotaFolio reads usage from your own account through the provider's sign-in, stores its token only in this Mac's Keychain, and is independent and not affiliated with Anthropic or OpenAI."
          }
        }
      }
    },
    "auth.fail.alreadyConnected": {
      "comment": "The grant just made belongs to a provider account the app already holds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have already added this account"
          }
        }
      }
    },
    "auth.fail.alreadyConnected.detail": {
      "comment": "Names the existing account a duplicate sign-in collides with.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sign-in is the same account as %1$@, so nothing was added."
          }
        }
      }
    },
    "auth.fail.browserOpen": {
      "comment": "Anthropic authorization browser could not open.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open your browser"
          }
        }
      }
    },
    "auth.fail.browserOpen.detail": {
      "comment": "A browser-open failure ends the current Anthropic transaction.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a fresh sign-in attempt."
          }
        }
      }
    },
    "auth.fail.denied": {
      "comment": "Provider denied authorization.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in was denied"
          }
        }
      }
    },
    "auth.fail.denied.detail": {
      "comment": "Provider authorization denial guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start over when you're ready."
          }
        }
      }
    },
    "auth.fail.deviceUnavailable": {
      "comment": "ChatGPT device-code sign-in is disabled by the account or workspace.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device-code sign-in is turned off"
          }
        }
      }
    },
    "auth.fail.deviceUnavailable.detail": {
      "comment": "ChatGPT device-code admin/security failure explanation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QotaFolio can't add this ChatGPT account until its security setting or workspace policy changes."
          }
        }
      }
    },
    "auth.fail.exchange": {
      "comment": "Provider token exchange failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't complete sign-in"
          }
        }
      }
    },
    "auth.fail.exchange.detail": {
      "comment": "Single-use token exchange failure guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The authorization code can't be reused. Start over."
          }
        }
      }
    },
    "auth.fail.expired": {
      "comment": "Provider sign-in deadline expired.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sign-in request expired"
          }
        }
      }
    },
    "auth.fail.expired.anthropic": {
      "comment": "Anthropic deadline-expired guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a fresh Anthropic sign-in attempt."
          }
        }
      }
    },
    "auth.fail.expired.chatgpt": {
      "comment": "ChatGPT deadline-expired guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a new ChatGPT device code to continue."
          }
        }
      }
    },
    "auth.fail.listener": {
      "comment": "Anthropic loopback listener could not start.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't start the local sign-in listener"
          }
        }
      }
    },
    "auth.fail.listener.detail": {
      "comment": "Anthropic loopback listener failure guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If this persists, check the app's network permissions."
          }
        }
      }
    },
    "auth.fail.rateLimited": {
      "comment": "ChatGPT device-code start was rate-limited.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts"
          }
        }
      }
    },
