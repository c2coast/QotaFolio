    "catalog.advisory.credentialsUnreadableCatalog.many": {
      "comment": "Recovery advisory when multiple Keychain credentials survive a durably damaged account catalog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld saved sign-ins are still in your Mac's Keychain, so do not sign in again yet. Adding and changing accounts stays unavailable while the list is damaged."
          }
        }
      }
    },
    "catalog.advisory.credentialsUnreadableCatalog.one": {
      "comment": "Recovery advisory when one Keychain credential survives a durably damaged account catalog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 saved sign-in is still in your Mac's Keychain, so do not sign in again yet. Adding and changing accounts stays unavailable while the list is damaged."
          }
        }
      }
    },
    "catalog.advisory.credentialsWithoutCatalog.many": {
      "comment": "Recovery advisory when multiple Keychain credentials survive a missing account catalog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QotaFolio's account list is missing, but %1$lld saved sign-ins are still in your Mac's Keychain. Nothing has been deleted. Add your accounts again to continue."
          }
        }
      }
    },
    "catalog.advisory.credentialsWithoutCatalog.one": {
      "comment": "Recovery advisory when one Keychain credential survives a missing account catalog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QotaFolio's account list is missing, but 1 saved sign-in is still in your Mac's Keychain. Nothing has been deleted. Add your account again to continue."
          }
        }
      }
    },
    "catalog.advisory.storeUnreachable": {
      "comment": "Recovery advisory when the account catalog is missing and the credential store could not be checked.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QotaFolio couldn't check your saved sign-ins, so it doesn't know which of them are still there. Nothing has been deleted or changed. Quit and reopen QotaFolio to let it check again, or add an account now."
          }
        }
      }
    },
    "catalog.advisory.storeUnreachableUnreadableCatalog": {
      "comment": "Recovery advisory when the account catalog is durably damaged and the credential store could not be checked.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QotaFolio also couldn't check your saved sign-ins, so it doesn't know which of them remain. Nothing has been deleted or changed, so do not sign in again yet. Adding and changing accounts stays unavailable while the list is damaged."
          }
        }
      }
    },
    "catalog.advisory.temporarilyUnreadable": {
      "comment": "Recovery advisory when the account catalog read never happened and a retry is offered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing about your saved sign-ins has changed. Adding and changing accounts stays unavailable until the list loads."
          }
        }
      }
    },
    "catalog.loading": {
      "comment": "Startup placeholder while the account catalog loads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading accounts…"
          }
        }
      }
    },
    "catalog.unreadable.body.damaged": {
      "comment": "Unreadable-catalog guidance when the saved bytes are durably corrupt.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QotaFolio's saved account list is damaged, so it can't be read. Nothing has been deleted. Reopening QotaFolio won't repair the list — Settings has the option to remove QotaFolio and start over."
          }
        }
      }
    },
    "catalog.unreadable.body.temporary": {
      "comment": "Unreadable-catalog guidance when the read never happened and an in-app retry is offered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QotaFolio couldn't read its saved accounts just now. Nothing has been deleted, and the list may load on the next attempt."
          }
        }
      }
    },
