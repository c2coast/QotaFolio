{
  "sourceLanguage": "en",
  "strings": {
    "about.nonAffiliation": {
      "comment": "Required trademark and non-affiliation statement.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic, Claude, OpenAI, and ChatGPT are trademarks of their respective owners. QotaFolio is an independent product and is not affiliated with, endorsed by, or sponsored by Anthropic or OpenAI."
          }
        }
      }
    },
    "about.version": {
      "comment": "App version and build number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ (%2$@)"
          }
        }
      }
    },
    "account.ax.label": {
      "comment": "VoiceOver label for an account card: the user's name for the account, then the provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "account.generic": {
      "comment": "Generic account name used only if a connected row is not yet visible.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        }
      }
    },
    "action.cancel": {
      "comment": "Cancel an in-progress operation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "action.continue": {
      "comment": "Continue to provider sign-in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        }
      }
    },
    "action.dismiss": {
      "comment": "Dismiss a terminal sign-in failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        }
      }
    },
    "action.more": {
      "comment": "Account actions menu help text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More actions"
          }
        }
      }
    },
    "action.more.forAccount": {
      "comment": "VoiceOver label for one account row's actions menu. The placeholder is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More actions for %1$@"
          }
        }
      }
    },
    "action.moveDown": {
      "comment": "Move an account later in display order.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Down"
          }
        }
      }
    },
    "action.moveUp": {
      "comment": "Move an account earlier in display order.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Up"
          }
        }
      }
    },
    "action.openSettings": {
      "comment": "Open QotaFolio Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "action.reconnect": {
      "comment": "Reconnect an account with the provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect…"
          }
        }
      }
    },
    "action.remove": {
      "comment": "Confirm destructive account removal.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        }
      }
    },
    "action.removeAccount": {
      "comment": "Remove one connected account and its saved sign-in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Account"
          }
        }
      }
    },
    "action.rename": {
      "comment": "Rename an account.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename…"
          }
        }
      }
    },
    "action.retry": {
      "comment": "Retry refreshing one account.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        }
      }
    },
    "action.save": {
      "comment": "Save an edited account name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        }
      }
    },
    "action.startOver": {
      "comment": "Start a fresh provider sign-in after a terminal failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start over"
          }
        }
      }
    },
    "action.tryAgain": {
      "comment": "Start a fresh attempt after a failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "alert.fresh.scoped": {
      "comment": "Alert body when a model-scoped window has just turned over. The account, then the scope's name as the provider spells it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reset — a fresh %2$@ window."
          }
        }
      }
    },
    "alert.fresh.session": {
      "comment": "Alert body when an account's five-hour window has just turned over. The argument is the account name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reset — a fresh five-hour window."
          }
        }
      }
    },
    "alert.fresh.weekly": {
      "comment": "Alert body when an account's weekly window has just turned over. The argument is the account name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reset — a fresh week."
          }
        }
      }
    },
    "alert.runningOut": {
      "comment": "Alert body when an account's window runs dry and no reset time is known. The account, the clock time it runs out, then the other-account clause or nothing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ runs out at %2$@ at this pace.%3$@"
          }
        }
      }
    },
    "alert.runningOut.beforeReset": {
      "comment": "Alert body when an account's window runs dry before its reset. The account, the clock time it runs out, how long before the reset, then the other-account clause or nothing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ runs out at %2$@ at this pace — %3$@ before its reset.%4$@"
          }
        }
      }
    },
    "alert.runningOut.other": {
      "comment": "Clause appended to a running-out alert, naming another account and what it has left now. Leading space included. An account name, then a percentage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$@ has %2$@."
          }
        }
      }
    },
    "alert.stranding": {
      "comment": "Alert body when part of an account's week will expire unused. The account, a percentage, then the weekday it expires.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: about %2$@ of the week expires %3$@."
          }
        }
      }
    },
    "announce.addressCopied": {
      "comment": "VoiceOver announcement after copying the device authorization URL.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web address copied"
          }
        }
      }
    },
    "announce.auth.anthropicBrowser": {
      "comment": "VoiceOver announcement when the Anthropic sign-in hands the user to their browser. Only the host is spoken.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish signing in to %1$@ in your browser. QotaFolio is waiting."
          }
        }
      }
    },
    "announce.auth.deviceCode": {
      "comment": "VoiceOver announcement when the ChatGPT device code appears. The code is spelled one character at a time so it can be transcribed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter this code on the ChatGPT authorization page in your browser: %1$@"
          }
        }
      }
    },
    "announce.auth.starting": {
      "comment": "VoiceOver announcement when a sign-in starts and the naming step is replaced by the progress step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting sign-in to %1$@"
          }
        }
      }
    },
    "announce.codeCopied": {
      "comment": "VoiceOver announcement after copying a device code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code copied"
          }
        }
      }
    },
    "announce.connected": {
      "comment": "VoiceOver announcement after an account successfully connects.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ connected"
          }
        }
      }
    },
    "announce.launchAtLogin.disabled": {
      "comment": "VoiceOver announcement after the app reconciles an Open-at-Login removal made in System Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login is off"
          }
        }
      }
    },
    "announce.launchAtLogin.enabled": {
      "comment": "VoiceOver announcement after the app reconciles an Open-at-Login approval made in System Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login is on"
          }
        }
      }
    },
    "announce.launchAtLogin.needsApproval": {
      "comment": "VoiceOver announcement after the app reconciles an Open-at-Login registration that is still waiting for approval.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login needs your approval in System Settings"
          }
        }
      }
    },
    "announce.moved": {
      "comment": "VoiceOver announcement after account reorder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved %1$@ to position %2$lld of %3$lld"
          }
        }
      }
    },
    "announce.refreshNoVisibleAccounts": {
      "comment": "VoiceOver announcement after a manual refresh when the defensive zero-visible state is active.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh completed. No accounts are visible."
          }
        }
      }
    },
    "announce.refreshUnavailable": {
      "comment": "VoiceOver announcement after a manual refresh with unavailable accounts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh completed with %1$lld accounts unavailable; cached data shown"
          }
        }
      }
    },
    "announce.renamed": {
      "comment": "VoiceOver announcement after an account is renamed. The argument is the new name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renamed to %1$@"
          }
        }
      }
    },
    "announce.usageUpdated": {
      "comment": "VoiceOver announcement after a successful manual refresh cohort.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage updated"
          }
        }
      }
    },
    "auth.add.heading": {
      "comment": "Heading for the add-account naming step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an account"
          }
        }
      }
    },
    "auth.add.refused.finishingQuit": {
      "comment": "Shown on the add-account naming step when a quit holds account changes closed. Nothing is being deleted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account was not added. QotaFolio is finishing quitting, and nothing is being deleted."
          }
        }
      }
    },
    "auth.add.refused.limit": {
      "comment": "Shown on the add-account naming step when the five-account maximum refused the new account.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QotaFolio holds five accounts. Remove one before you add another."
          }
        }
      }
    },
    "auth.add.refused.notReserved": {
      "comment": "Shown on the add-account naming step when reserving a place for the new account failed for an unexpected reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QotaFolio could not start adding this account. Press Continue again in a moment."
          }
        }
      }
    },
    "auth.add.refused.unreadable": {
      "comment": "Shown on the add-account naming step when the account list could not be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QotaFolio cannot read your account list right now. This account was not added."
          }
        }
      }
    },
    "auth.anthropic.body": {
      "comment": "Anthropic loopback OAuth instructions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish signing in in your browser. You can reopen the same authorization page without restarting this sign-in."
          }
        }
      }
    },
    "auth.anthropic.openAgain": {
      "comment": "Reopen the live Anthropic authorization URL.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open browser again"
          }
        }
      }
    },
    "auth.anthropic.waiting": {
      "comment": "Anthropic browser OAuth wait state. Only the host is shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for %1$@ to confirm…"
          }
        }
      }
    },
    "auth.chatgpt.code.label": {
      "comment": "VoiceOver label for the exact ChatGPT device code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT device code"
          }
        }
      }
    },
    "auth.chatgpt.copyAddress": {
      "comment": "Copy the ChatGPT device authorization URL.",
