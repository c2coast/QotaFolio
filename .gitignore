# macOS
.DS_Store

# Swift and Xcode build products
.build/
.artifacts/
DerivedData/
*.xcarchive
*.xcresult
*.dSYM
.swiftpm/

# XcodeGen regenerates the project from project.yml.
/*.xcodeproj/

# Xcode per-user state
**/xcuserdata/
*.xcuserstate

# Python bytecode from tools/
__pycache__/
*.py[cod]

# The sessions' own tooling stays on each Mac, except the skills, which the repository carries.
/.claude/*
!/.claude/skills/
